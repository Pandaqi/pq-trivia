{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src"
  },
  "include": [
    "src/core/**/*",
    "src/entries/**/*",
    "src/renderers/**/*",
    "src/editor/**/*",
    "src/platform/**/*",
    "src/multiplayer/**/*",
    "src/shared/**/*",
    "src/i18n/**/*",
    "src/animations/**/*"
  ],
  "exclude": ["src/v2/**/*"]
}
